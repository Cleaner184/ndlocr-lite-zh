+# ---------------------------------------------------------------------------
+# 可选功能模块（src/optional_features/llm.py / data_pool.py / table_structure.py）
+# 的接入支持
+#
+# 这三个模块随发布包分发，不在公开仓库里，因此无法直接调用 get_text()。
+# 提供两种接入方式，都不需要改动模块源码：
+#
+#   1) register_translations({...})
+#      模块把自己的文案登记进同一套字典（键名建议加前缀 llm_ / datapool_ /
+#      table_structure_），之后即可像内置文案一样维护 zh / en 译文。
+#
+#   2) translate_literal(text, langcode)
+#      控件里已经写死的日文/英文原文，按"原文 → 译文"直接替换。
+#      只要字典里某条目的 ja（或 en）值与该原文完全一致就能命中，
+#      所以模块一行代码都不用改，对 .pyc 发布版同样有效。
+# ---------------------------------------------------------------------------
+
+_LITERAL_INDEX_CACHE = {}
+
+
+def _build_literal_index():
+    """构建 {原文: {目标语言: 译文}} 索引，供 translate_literal() 使用。"""
+    index = {}
+    for entry in TRANSLATIONS.values():
+        for source_lang in ('ja', 'en'):
+            source_text = entry.get(source_lang)
+            if not source_text:
+                continue
+            targets = index.setdefault(source_text, {})
+            for target_lang, translated in entry.items():
+                if target_lang == source_lang:
+                    continue
+                targets.setdefault(target_lang, translated)
+    return index
+
+
+def translate_literal(text, langcode):
+    """把控件里写死的原文替换为目标语言；没有对应译文时原样返回。"""
+    if not isinstance(text, str) or not text or langcode == 'ja':
+        return text
+    if not _LITERAL_INDEX_CACHE:
+        _LITERAL_INDEX_CACHE.update(_build_literal_index())
+    targets = _LITERAL_INDEX_CACHE.get(text.strip())
+    if not targets:
+        return text
+    return targets.get(langcode) or text
+
+
+def register_translations(entries):
+    """合并外部（可选功能模块）提供的文案条目。
+
+    Args:
+        entries: {键名: {语言代码: 文本}}，与 TRANSLATIONS 同构。
+                 已存在的键只补齐/覆盖对应语言，不会丢掉内置译文。
+    """
+    for key, entry in (entries or {}).items():
+        if key in TRANSLATIONS:
+            TRANSLATIONS[key].update(entry)
+        else:
+            TRANSLATIONS[key] = dict(entry)
+    _LITERAL_INDEX_CACHE.clear()
+
+# ---------------------------------------------------------------------------
+# 控件树兜底本地化（不依赖 flet：只按属性名遍历，鸭子类型）
+# ---------------------------------------------------------------------------
+
+CONTROL_TEXT_ATTRS = (
+    'value', 'text', 'label', 'title', 'subtitle', 'tooltip',
+    'hint_text', 'helper_text', 'content', 'message',
+    'prefix_text', 'suffix_text',
+)
+CONTROL_CHILD_ATTRS = (
+    'controls', 'content', 'title', 'label', 'actions', 'subtitle',
+    'leading', 'trailing', 'hint_text', 'helper_text', 'tooltip', 'menu_items',
+)
+_CJK_PATTERN = re.compile('[\u3040-\u30ff\u3400-\u9fff]')
+
+
+def _localize_node(node, langcode, collect_untranslated, depth, seen):
+    if node is None or depth > 20:
+        return
+    if isinstance(node, (list, tuple, set)):
+        for item in node:
+            _localize_node(item, langcode, collect_untranslated, depth + 1, seen)
+        return
+    if not hasattr(node, '__dict__') or id(node) in seen:
+        return
+    seen.add(id(node))
+    for attr in CONTROL_TEXT_ATTRS:
+        try:
+            value = getattr(node, attr, None)
+        except Exception:
+            continue
+        if not isinstance(value, str) or not value.strip():
+            continue
+        translated = translate_literal(value, langcode)
+        if translated != value:
+            try:
+                setattr(node, attr, translated)
+            except Exception:
+                pass
+        elif collect_untranslated is not None and _CJK_PATTERN.search(value):
+            collect_untranslated.add(value.strip())
+    for attr in CONTROL_CHILD_ATTRS:
+        try:
+            child = getattr(node, attr, None)
+        except Exception:
+            continue
+        if child is None or isinstance(child, str):
+            continue
+        _localize_node(child, langcode, collect_untranslated, depth + 1, seen)
+
+
+def localize_tree(root, langcode, collect_untranslated=None):
+    """对第三方模块搭建的控件树做"原文 → 当前语言"的兜底替换。
+
+    可选功能模块（llm / data_pool / table_structure）不在公开仓库中，无法调用
+    get_text()，因此在渲染前对其控件树做一次整体替换：只要字典里某条目的 ja
+    （或 en）译文与该控件上的字符串完全一致就能命中。未命中的日文文案会收集到
+    collect_untranslated 中，便于补齐字典。
+    """
+    if langcode == 'ja':
+        return
+    _localize_node(root, langcode, collect_untranslated, 0, set())
