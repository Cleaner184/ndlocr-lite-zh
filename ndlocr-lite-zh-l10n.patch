+"""NDLOCR-Lite GUI 的界面文本字典。
+
+支持的语言代码：
+    ja : 日本語（默认）
+    en : English
+    zh : 简体中文
+
+新增语言时，在每个条目里补上对应的语言代码即可；缺项会按
+DEFAULT_LANGCODE -> FALLBACK_LANGCODES 的顺序回退，不会抛 KeyError。
+"""
+
+import re
+
+DEFAULT_LANGCODE = 'ja'
+FALLBACK_LANGCODES = ('en', 'ja')
+
+
+def get_text(key: str, langcode: str = DEFAULT_LANGCODE, **kwargs) -> str:
+    """按语言代码取出界面文本。
+
+    Args:
+        key: TRANSLATIONS 中的条目名。
+        langcode: 语言代码（ja / en / zh）。
+        **kwargs: 需要代入 {name} 占位符的值。
+
+    Returns:
+        该语言的文本；找不到时回退到 en / ja，最后回退为 key 本身。
+    """
+    entry = TRANSLATIONS.get(key)
+    if entry is None:
+        return key
+    text = entry.get(langcode)
+    if text is None:
+        for fallback in FALLBACK_LANGCODES:
+            if fallback in entry:
+                text = entry[fallback]
+                break
+    if text is None:
+        text = key
+    if kwargs:
+        try:
+            text = text.format(**kwargs)
+        except (KeyError, IndexError, ValueError):
+            return text
+    return text
+
