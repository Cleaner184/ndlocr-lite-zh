+def tr(key, langcode, **kwargs):
+    """按当前界面语言取文本（zh/ja/en），缺失时回退。"""
+    return get_text(key, langcode, **kwargs)
+
+
+def dump_untranslated_strings(strings):
+    """设置环境变量 NDLOCR_GUI_DUMP_UNTRANSLATED=1 时，导出未翻译的日文文案。"""
+    if not strings or not os.environ.get('NDLOCR_GUI_DUMP_UNTRANSLATED'):
+        return
+    out_path = APP_DATA_DIR / 'untranslated_gui_strings.txt'
+    try:
+        APP_DATA_DIR.mkdir(parents=True, exist_ok=True)
+        existing = set()
+        if out_path.exists():
+            existing = {
+                line.rstrip('\n')
+                for line in out_path.read_text(encoding='utf-8').splitlines()
+            }
+        merged = sorted(existing | set(strings))
+        out_path.write_text('\n'.join(merged) + '\n', encoding='utf-8')
+        print(f'[i18n] untranslated UI strings -> {out_path}')
+    except Exception as ex:
+        print(f'[i18n] failed to dump untranslated strings: {ex}')
+
+
+def build_models_ready_message(langcode, elapsed, table_feature_enabled, table_error):
+    """OCR 模型加载完成后的状态提示。"""
+    if not table_feature_enabled:
+        key = 'main_models_ready'
+    elif table_error is None:
+        key = 'main_models_ready_with_table'
+    else:
+        key = 'main_models_ready_table_failed'
+    return get_text(key, langcode, elapsed=elapsed)
+
